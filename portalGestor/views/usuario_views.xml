<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Campo fecha_baja: aparece cuando baja=True -->
    <record id="portalgestor_usuario_form_inherit_fecha_baja" model="ir.ui.view">
        <field name="name">usuarios.usuario.form.portalgestor.fecha_baja</field>
        <field name="model">usuarios.usuario</field>
        <field name="inherit_id" ref="usuarios.usuario_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='baja']" position="after">
                <field
                    name="fecha_baja"
                    invisible="not baja"
                    readonly="manager_edit_blocked"
                    required="baja"
                    string="Baja desde"
                    options="{'datepicker': {'warn_future': false}}"
                />
            </xpath>
        </field>
    </record>

    <record id="portalgestor_usuario_form_inherit_report_button" model="ir.ui.view">
        <field name="name">usuarios.usuario.form.portalgestor.report.button</field>
        <field name="model">usuarios.usuario</field>
        <field name="inherit_id" ref="usuarios.usuario_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet" position="before">
                <header>
                    <button
                        name="action_open_horario_usuario_report_wizard"
                        string="Horario usuario"
                        type="object"
                        class="oe_highlight"
                        invisible="manager_edit_blocked"
                        groups="gestores.group_gestores_agusto,gestores.group_gestores_intecum,gestores.group_gestores_administrador"
                    />
                    <button
                        name="action_open_catering_comida_config"
                        string="Configurar catering comida"
                        type="object"
                        invisible="manager_edit_blocked or not has_catering_comida_service"
                        groups="gestores.group_gestores_agusto,gestores.group_gestores_intecum,gestores.group_gestores_administrador"
                    />
                    <button
                        name="action_open_catering_cena_config"
                        string="Configurar catering cena"
                        type="object"
                        invisible="manager_edit_blocked or not has_catering_cena_service"
                        groups="gestores.group_gestores_agusto,gestores.group_gestores_intecum,gestores.group_gestores_administrador"
                    />
                    <button
                        name="action_open_taxi_config"
                        string="Configurar taxi"
                        type="object"
                        invisible="manager_edit_blocked or not has_taxi_service"
                        groups="gestores.group_gestores_agusto,gestores.group_gestores_intecum,gestores.group_gestores_administrador"
                    />
                    <button
                        name="action_open_lavanderia_config"
                        string="Configurar lavanderia"
                        type="object"
                        invisible="manager_edit_blocked or not has_lavanderia_service"
                        groups="gestores.group_gestores_agusto,gestores.group_gestores_intecum,gestores.group_gestores_administrador"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
